{
  "name": "ticket-bot",
  "version": "2.0.0",
  "description": "A versatile Discord.js bot with modular commands, ticketing, leveling, suggestions, feedback, polls, and welcome systems",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "format": "prettier --write \"src/**/*.js\""
  },
  "imports": {
    "#commands/*": "./src/commands/*.js",
    "#structures/*": "./src/structures/*.js",
    "#database/*": "./src/database/*.js",
    "#config/*": "./src/config/*.js",
    "#utils/*": "./src/utils/*.js",
    "#events/*": "./src/events/*.js",
    "#handlers/*": "./src/structures/handlers/*.js",
    "#classes/*": "./src/structures/classes/*.js",
    "#db/*": "./src/database/*.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KAJUKATLIii/ticket.git"
  },
  "bugs": {
    "url": "https://github.com/KAJUKATLIii/ticket/issues"
  },
  "homepage": "https://github.com/KAJUKATLIii/ticket#readme",
  "keywords": [
    "discord",
    "bot",
    "discord.js",
    "ticket-bot",
    "leveling",
    "suggestions",
    "feedback",
    "polls",
    "canvas"
  ],
  "author": "KAJUKATLii",
  "license": "MIT",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "better-sqlite3": "^12.0.0",
    "canvas": "^3.0.0",
    "discord-html-transcripts": "^3.2.0",
    "discord.js": "^14.25.1",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "prettier": "^3.7.4",
    "sql.js": "^1.12.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
